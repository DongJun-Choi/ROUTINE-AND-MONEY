generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int          @id @default(autoincrement())
  name      String       @unique
  parentId  Int?
  parent    Category?    @relation("SubCategories", fields: [parentId], references: [id])
  children  Category[]   @relation("SubCategories")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  transactions Transaction[]
  rules        CategoryRule[]
}

model Transaction {
  id           Int       @id @default(autoincrement())
  date         DateTime
  merchant     String
  amount       Int
  paymentType  String
  memo         String?
  categoryId   Int?
  category     Category? @relation(fields: [categoryId], references: [id])
  type         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model CategoryRule {
  id          Int        @id @default(autoincrement())
  keyword     String
  categoryId  Int
  category    Category   @relation(fields: [categoryId], references: [id])

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([keyword, categoryId])
}

model ExcelUploadLog {
  id        Int      @id @default(autoincrement())
  date      String
  rowCount  Int
  createdAt DateTime @default(now())

  @@unique([date, rowCount])
}

model MailImportLog {
  id              Int      @id @default(autoincrement())
  provider        String
  mailbox         String
  uid             Int
  messageId       String?
  subject         String?
  attachmentName  String?
  statementMonth  String?
  rowCount        Int?
  duplicateUpload Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([provider, mailbox, uid])
}
